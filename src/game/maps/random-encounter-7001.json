    "neutralSpawns": [
      {
        "name": "Andarilho Encapuzado",
        "classId": "sorcerer",
        "x": 5,
        "y": 5,
        "dialog": {
          "id": "hooded-wanderer",
          "startId": "l1",
          "lines": [
            {
              "id": "l1",
              "speaker": "Andarilho Encapuzado",
              "text": "\"Sentem os cascalhos frios embaixo desse santuário quebrado? Alguém rezou aqui, uma vez. Não adiantou.\"",
              "replies": [
                { "text": "Quem é você?", "next": "l2" },
                { "text": "O que aconteceu aqui?", "next": "l3" },
                { "text": "Não temos tempo pra isso.", "next": "l5" }
              ]
            },
            {
              "id": "l2",
              "speaker": "Andarilho Encapuzado",
              "text": "\"Alguém que ainda anda pelas estradas que os outros abandonaram. Um nome não vai mudar o que vem a seguir.\"",
              "replies": [
                { "text": "\"O que vem a seguir?\"", "next": "l4" },
                { "text": "Deixa pra lá.", "next": "l5" }
              ]
            },
            {
              "id": "l3",
              "speaker": "Andarilho Encapuzado",
              "text": "\"Os cultistas vieram atrás de algo enterrado sob as pedras. Não encontraram — mas ainda estão procurando. Fiquem de olho.\"",
              "next": "l5"
            },
            {
              "id": "l4",
              "speaker": "Andarilho Encapuzado",
              "text": "\"Isso cabe a vocês descobrirem. Eu só aviso o que já vi passar por aqui antes — e nunca é bom sinal.\"",
              "next": "l5"
            },
            {
              "id": "l5",
              "speaker": "Andarilho Encapuzado",
              "text": "\"Cuidado com as sombras entre as pedras. Elas não são só sombras.\"",
              "next": null
            }
          ]
        }
      }
    ],
